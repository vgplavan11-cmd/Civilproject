# ==============================================================================
# NODEMAILER & SMTP CONFIGURATION
# Copy this file to .env.local and fill in your actual SMTP credentials.
# ==============================================================================

# SMTP Service Host (e.g. smtp.gmail.com for Gmail, smtp.hostinger.com, etc.)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Secure flag: true for port 465, false for 587
SMTP_SECURE=true

# Sender Email Address (e.g. your Gmail or business domain email)
SMTP_USER=your-email@gmail.com

# Sender Email Password / App Password
# For Gmail: Use a 16-character Google App Password (NOT your personal login password).
# See: https://myaccount.google.com/apppasswords
SMTP_PASS=your-16-char-app-password

# Email Address where website inquiries and BOQ estimate requests are delivered
CONTACT_RECEIVER_EMAIL=your-company-inbox@gmail.com

# Sender Display Name
SMTP_FROM_NAME="Elite Homes Civil Engineering"

